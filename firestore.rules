rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

function isAdministrator() {
  return request.auth != null
    && exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
    && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role == 'administrator';
}

    

 match /accounts/{userId} {
  allow read: if request.auth != null
    && (
      request.auth.uid == userId
      || isAdministrator()
    );

    allow create: if request.auth != null
    && request.auth.uid == userId
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.role in [
      'administrator',
      'local'
    ];


  allow update: if isAdministrator();
}


    match /loginAliases/{username} {
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null;

      allow update, delete: if isAdministrator()
        || (
          request.auth != null
          && request.auth.uid == resource.data.uid
        );
    }

match /locals/{localId} {
  allow read: if request.auth != null;
  allow create, update, delete: if isAdministrator();
}


    match /giftCards/{giftCardId} {
  allow read: if request.auth != null;

  allow create, delete: if isAdministrator();

  allow update: if isAdministrator()
    || (
      request.auth != null
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'usedAmount',
        'remainingAmount',
        'status',
        'updatedAt'
      ])
      && request.resource.data.code == resource.data.code
      && request.resource.data.amount == resource.data.amount
      && request.resource.data.dedication == resource.data.dedication
      && request.resource.data.status in [
        'Parcialmente usada',
        'Canjeada'
      ]
    );
}

    
match /giftCardUsages/{usageId} {
  allow read: if request.auth != null;

  allow create: if request.auth != null
    && request.resource.data.keys().hasAll([
      'giftCardCode',
      'amountUsed',
      'username',
      'accountUid',
      'usedAt'
    ])
    && request.resource.data.keys().hasOnly([
      'giftCardCode',
      'amountUsed',
      'username',
      'accountUid',
      'usedAt'
    ])
    && request.resource.data.accountUid == request.auth.uid
    && request.resource.data.giftCardCode is string
    && request.resource.data.amountUsed is string
    && request.resource.data.amountUsed.matches('^[1-9][0-9]*$')
    && request.resource.data.username is string
    && request.resource.data.username.size() > 0
    && request.resource.data.usedAt == request.time;

  allow update, delete: if isAdministrator();
}

    match /counters/{counterId} {
      allow read, write: if isAdministrator();
    }

    match /publicEcards/{shareToken} {
      allow get: if true;
      allow list: if false;

      allow create, update, delete: if isAdministrator();
    }
  }
}

